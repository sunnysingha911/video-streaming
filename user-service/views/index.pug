doctype html
html
  head
    title= title
    style.
      body { font-family: Arial, sans-serif; margin: 20px; }
      h1 { color: #333; }
  body
    h1= title
    p Welcome to your Express application with Pug!

    h2 API Endpoints
    ul
      li POST /api/auth/register - Register a new user
      li POST /api/auth/login - Login a user
      li GET /api/users/me - Get current user information (requires token)

    p To test the database connection, visit 
      a(href="/test-db") /test-db 